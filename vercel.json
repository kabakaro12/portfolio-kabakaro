{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/google-calendar/auth",
      "destination": "/api/google-calendar-auth"
    },
    {
      "source": "/api/google-calendar/callback",
      "destination": "/api/google-calendar-callback"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth-register"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth-login"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth-me"
    },
    {
      "source": "/api/cv",
      "destination": "/api/cv-list"
    },
    {
      "source": "/api/cv/duplicate",
      "destination": "/api/cv-duplicate"
    },
    {
      "source": "/api/cv/:id",
      "destination": "/api/cv-item?id=:id"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  }
}
